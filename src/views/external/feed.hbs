<div id="dashboard--lead__container" class="rounded-panel info margin">
	<img id="dashboard--lead__img" src="/favicon.png" />
	<div id="dashboard--lead__text">
		Hello! I personally track everything I listen to, everything I
		watch on TV, every game I play, and more. And so, I call this
		project “Everything”. You can find out more by visiting the
		<a href="https://github.com/moonfloof/everything#readme" target="_blank"><strong>code repository
				homepage</strong> {{>svg/external}}</a>.
	</div>
</div>

{{#if showDashboard}}
<div id="dash-panels">
	{{#if latestGame}}
	{{#> dashpanel title="last played game" more="games" url=latestGame.canonicalUrl }}
	<div class="left">{{latestGame.name}}</div>
	<div class="right">{{latestGame.timeago}}</div>
	{{/dashpanel}}
	{{/if}}

	{{#if latestCheckin}}
	{{#> dashpanel title="last check-in" more="checkin" url=latestCheckin.canonicalUrl }}
	<div class="left">{{latestCheckin.name}}</div>
	<div class="right">{{latestCheckin.timeago}}</div>
	{{/dashpanel}}
	{{/if}}

	{{#if latestFilm}}
	{{#> dashpanel title="last film watched" more="films" url=latestFilm.canonicalUrl }}
	<div class="left">{{latestFilm.title}}</div>
	<div class="right">{{latestFilm.timeago}}</div>
	{{/dashpanel}}
	{{/if}}

	{{#if latestSteps}}
	{{#> dashpanel title="yesterday's step count" }}
	<div class="left large">{{latestSteps.step_count_total}}</div>
	<div class="right">steps</div>
	{{/dashpanel}}
	{{/if}}

	{{#if latestSleep}}
	{{#> dashpanel title="latest sleep" }}
	<div class="left large">{{latestSleep.duration}}</div>
	<div class="right">{{latestSleep.timeago}}</div>
	{{/dashpanel}}
	{{/if}}

	{{#if latestLocation}}
	{{#> dashpanel title="latest location" }}
	<div class="left">{{latestLocation}}</div>
	{{/dashpanel}}
	{{/if}}
</div>
<hr>
{{/if}}

<div class="home-links">
	<span>more pages:</span>
	<a href="/games">games</a>
	<a href="/music">music</a>
	<a href="/films">films</a>
	<a href="/checkin">check-ins</a>
	<a href="/notes">notes</a>
	<a href="/youtube">youtube</a>
	<a href="/tv">tv episodes</a>
	<a href="/books">books</a>
</div>

{{#each entries as |entry|}}
{{#xif type '==' 'note'}}{{> note data=data }}{{/xif}}
{{#xif type '==' 'game'}}{{> gameActivity data=data }}{{/xif}}
{{#xif type '==' 'episode'}}{{> tv data=data }}{{/xif}}
{{#xif type '==' 'book'}}{{> book data=data }}{{/xif}}
{{#xif type '==' 'like'}}{{> youtubeLike data=data }}{{/xif}}
{{#xif type '==' 'film'}}{{> film data=data }}{{/xif}}
{{#xif type '==' 'listen'}}{{> listenCompact data=data }}{{/xif}}
{{#xif type '==' 'checkin'}}{{> checkin data=data }}{{/xif}}
{{#xif type '==' 'steps'}}{{> stepsDaily data=data }}{{/xif}}
{{/each}}
