<div class="h-entry panel{{#if data.rating}} h-review{{/if}}">
	<div class="flex-row">
		{{#if data.posterUrl}}
		<img class="entry-poster" alt="Film poster for '{{data.title}}'" src="{{data.posterUrl}}" />
		{{/if}}

		<div class="content">
			{{#if hideTitle}}
			<data class="p-name p-item" value="{{data.title}}"></data>
			{{else}}
			<p class="large">
				watched
				<a href="/film/{{data.id}}" class="u-uid u-url">
					<span class="p-name p-item">{{data.title}}</span>
					({{data.year}})
				</a>
			</p>
			{{/if}}

			{{#if data.review}}
			<div class="large e-content">{{{data.review}}}</div>
			{{/if}}

			<p>
				<data class="p-duration" value="{{data.durationIso}}">
					for <strong>{{data.durationPretty}}</strong>
				</data>
			</p>

			{{#if data.rating}}
			<p>
				rated
				<strong>
					<span class="p-rating">{{data.halfRating}}</span> /
					<span class="p-best">5</span>
				</strong>
				{{#each data.ratingStars as |star|}}{{>(star)}}{{/each}}
			</p>
			{{/if}}

			{{#if data.url}}
			<p>
				originally posted on
				<strong><a class="right u-watch-of" href="{{data.url}}" target="_blank"
						rel="noopener">{{data.urlPretty}}
						{{>svg/external}}</a></strong>
			</p>
			{{/if}}

			{{> author }}
		</div>
	</div>

	{{> panelFooter data moreUrl='/films' moreText='films' }}
</div>
