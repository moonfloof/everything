<div class="h-entry panel">
	{{#xif data.type '==' 'reply'}}
	{{#if data.url}}
	<p class="bar">
		↩ replied to
		<strong><a href="{{data.url}}" target="_blank" rel="noopener" class="u-in-reply-to">{{data.url}}
				{{>svg/external}}</a></strong>
	</p>
	{{/if}}
	{{/xif}}


	{{#xif data.type '==' 'repost'}}
	{{#if data.url}}
	<p class="bar">
		🔁 reposted
		<strong><a href="{{data.url}}" target="_blank" rel="noopener" class="u-repost-of">{{data.url}}
				{{>svg/external}}</a></strong>
	</p>
	{{/if}}
	{{/xif}}

	<div class="content">
		{{#unless hidetitle}}
		{{#if data.title}}
		<h2 class="p-name">{{data.title}}</h2>
		{{/if}}
		{{/unless}}

		<div class="e-content large">
			{{{data.description}}}
		</div>

		{{#xif data.type '==' 'audio'}}
		{{#if data.url}}
		<audio class="u-audio" controls src="{{data.url}}">
			<p>Unfortunately, your browser doesn't support this audio format</p>
		</audio>
		{{/if}}
		{{/xif}}

		{{#xif data.type '==' 'video'}}
		{{#if data.url}}
		<video class="u-video" src="{{data.url}}" controls>
			<p>Unfortunately, your browser doesn't support this video format</p>
		</video>
		{{/if}}
		{{/xif}}

		{{#xif data.type '==' 'photo'}}
		{{#if data.url}}
		<img class="u-photo" src="{{data.url}}" alt="{{data.title}}" />
		{{/if}}
		{{/xif}}

		{{#if data.syndication}}
		<p>
			also posted on:
			{{#each data.syndication as |site|}}
			<strong><a href="{{site.url}}" target="_blank" class="u-syndication">{{site.name}}
					{{>svg/external}}</a></strong>&nbsp;&nbsp;
			{{/each}}
		</p>
		{{/if}}

		{{> author }}
	</div>

	{{> panelFooter data moreUrl='/notes' moreText='notes' }}
</div>
