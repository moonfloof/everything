<div class="h-entry panel">
	<div class="content">
		<p class="large p-listen-of h-cite">
			listened to
			<strong class="p-publication">{{data.album}}</strong>
			by
			<strong class="p-author">{{data.artist}}</strong>
		</p>
		<p>
			{{data.count}} {{data.countText}}
			({{#each data.tracks as |track|}}<a href="/music/{{track.id}}"><strong>{{track.title}}</strong></a>{{#unless
			@last}}, {{/unless}}{{/each}})
		</p>
		{{#if data.durationSecs}}
		<p>for {{data.durationPretty}}</p>
		{{/if}}

		{{> author }}
	</div>

	{{> panelFooter data moreUrl='/music' moreText='music' }}
</div>
