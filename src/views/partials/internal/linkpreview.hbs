<form method="POST" action="/linkpreviews/{{data.htmlEncodedUrl}}">
	{{> internal/id id=data.id }}

	{{> internal/crudRow emoji="🔗" name="url" value=data.url }}
	{{> internal/crudRow emoji="🔖" name="title" value=data.title }}
{{> internal/crudRow emoji="🔖" name="description" value=data.description }}
	{{#if data.thumbnail_data}}
	<div class="row">
		<div class="left">🖼</div>
		<div class="checkin-image-container">
			<img src="{{data.imageBase64}}" class="checkin-image">
		</div>
	</div>
	{{/if}}
	{{> internal/crudRow emoji="🖼" name="imageurl" value=data.imageUrl }}

	{{> internal/crudSubmit }}
</form>
