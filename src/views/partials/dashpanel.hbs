<div class="panel panel__small home" id="panel__{{title}}">
	<div class="header">
		<h2 class="title">{{{title}}}</h2>
		{{#if more}}
		<a href="/{{more}}">more -&gt;</a>
		{{/if}}
	</div>
	{{#if url}}
	<a class="content" href="{{url}}">
		{{> @partial-block }}
	</a>
	{{else}}
	<div class="content">
		{{> @partial-block }}
	</div>
	{{/if}}
</div>
