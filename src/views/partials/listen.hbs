<div class="h-entry panel">
	<div class="content p-listen-of h-cite">
		<p class="large">
			listened to <strong class="p-name">{{data.title}}</strong>
			by <strong class="p-author">{{data.artist}}</strong>
		</p>
		<p>
			from <strong class="p-publication">{{data.album}}</strong>
			{{#if data.release_year}}
			<strong>({{data.release_year}})</strong>
			{{/if}}
		</p>
		{{#if data.duration_secs}}
		<p>
			for {{data.durationPretty}}
		</p>
		{{/if}}
	</div>

	{{> author }}

	{{> panelFooter data }}
</div>
