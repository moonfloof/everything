<div class="h-entry panel">
	<div class="content u-watch-of h-cite">
		<p class="large">
			watched <a href="/tv/{{data.id}}" class="u-uid u-url p-name">{{data.episode_title}}</a>
			from <strong class="p-author">{{data.series_title}}</strong>
		</p>

		{{#if data.durationPretty}}
		<data class="right p-duration" value="{{data.durationIso}}">for {{data.durationPretty}}</data>
		{{/if}}

		{{> author }}
	</div>

	{{> panelFooter data moreUrl='/tv' moreText='tv' }}
</div>
