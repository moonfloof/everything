<div class="h-entry panel{{#if data.rating}} h-review{{/if}}">
	<div class="content">
		<p class="large p-read-of h-cite">
			{{data.status}}
			{{#if data.url}}
			<a href="{{data.url}}" target="_blank" rel="noopener" class="u-url">
				<span class="p-name">{{data.title}}</span> {{> svg/external}}
			</a>
			{{else}}
			<strong class="p-name">{{data.title}}</strong>
			{{/if}}
			({{data.year}})
			<span>by <strong class="p-author">{{data.author}}</strong></span>
		</p>

		{{#if data.progress}}
		<data class="p-read-status" value="{{data.status}}"></data>
		<p>
			{{> svg/progress perfected=data.completed percentage=data.progress_percentage }}
			{{{data.progress}}}
		</p>
		{{/if}}

		{{#if data.started_at}}
		<p>started on <strong>{{data.started_at_pretty}}</strong></p>
		{{/if}}

		{{#if data.completed_at}}
		<p>finished on <strong>{{data.completed_at_pretty}}</strong></p>
		{{/if}}

		{{#if data.rating}}
		<p>
			rated
			<strong>
				<span class="p-rating">{{data.rating}}</span> /
				<span class="p-best">10</span>
			</strong>
		</p>
		{{/if}}

		{{#if data.genre}}
		<p class="p-category">{{data.genre}}</p>
		{{/if}}

		{{> author }}
	</div>

	{{> panelFooter data moreUrl='/books' moreText='books' }}
</div>
