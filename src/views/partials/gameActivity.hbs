<div class="h-entry panel">
	<div class="flex-row justify-start">
		{{#if data.posterUrl}}
		<img class="entry-poster" alt="Game poster for '{{data.name}}'" src="{{data.posterUrl}}" />
		{{/if}}

		<div class="content">
			<p class="large">
				played
				<a href="/game/{{data.game_id}}" rel="noopener">
					<span class="p-name">{{data.name}}</span>
				</a>
			</p>
			<p>
				for
				<data class="p-duration" value="{{data.durationIso}}">
					{{data.duration}}
				</data>
			</p>

			{{#if data.achievements}}
			{{#if data.perfectedSession}}
			<p class="game-achievements--bar pct-100" style="padding: 8px 0;">
				🥳 Got 100% during this session!
			</p>
			{{/if}}

			<p>Got <strong>{{data.achievements.length}}</strong> {{data.achievementText}}</p>
			<ul class="game-achievements--list">
				{{#each data.achievements as |achievement|}}
				<li>
					<time title="{{achievement.updated_at}}"
						datetime="{{achievement.updated_at}}"><strong>{{achievement.name}}</strong></time>
					{{#if achievement.description}}
					<br />{{achievement.description}}
					{{/if}}
				</li>
				{{/each}}
			</ul>
			{{/if}}

			{{#if data.url}}
			<a href="{{data.url}}" target="_blank" class="p-play-of h-cite u-url" rel="noopener">
				<strong>view store page</strong> {{>svg/external}}
			</a>
			{{/if}}


			{{> author }}
		</div>
	</div>

	{{> panelFooter data moreUrl='/games' moreText='games' }}
</div>
