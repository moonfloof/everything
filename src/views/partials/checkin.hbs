<div class="h-entry panel">
	<div class="content h-card">
		<p class="large">
			checked-in to
			<span class="p-name"><a href="/checkin/{{data.id}}">{{data.name}}</a></span>
		</p>

		{{#if data.description}}
		<div class="large e-content">{{{data.description}}}</div>
		{{/if}}

		<p class="p-location">{{data.address}}</p>
		<data class="p-latitude" value="{{data.lat}}"></data>
		<data class="p-longitude" value="{{data.long}}"></data>

		{{#if data.images}}
		<div class="checkin-image-row">
			{{#xif data.imageCount '<=' 3}} {{#each data.images as |image|}} <{{#if ../includePopovers}}button
				popovertarget="{{image.id}}" {{else}}div{{/if}}
				class="checkin-image-container width-{{../data.imageCount}}">
				<img src="{{image.fullUrl}}" class="checkin-image u-photo">
				</{{#if ../includePopovers}}button{{else}}div{{/if}}>
				{{/each}}
				{{else}}
				{{#each data.images as |image|}}
				<{{#if ../includePopovers}}button popovertarget="{{image.id}}" {{else}}div{{/if}}
					class="checkin-image-container width-{{../data.imageCount}}">
					<img src="{{image.thumbnailUrl}}" class="checkin-image u-photo">
				</{{#if ../includePopovers}}button{{else}}div{{/if}}>
				{{/each}}
				{{/xif}}
		</div>
		{{/if}}

		{{> author }}
	</div>
	{{> panelFooter data moreUrl='/checkin' moreText='check-ins' }}
</div>
